# ── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Direct URL (for Prisma migrations; set same as DATABASE_URL for local dev)
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# For serverless (Vercel/Neon), use pooled connection string:
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?pgbouncer=true&connection_limit=1
# and DIRECT_URL for the non-pooled variant.

# ── Azure OpenAI (preferred) ──────────────────────────────
# The app uses Azure OpenAI by default. Set the two required vars below.
# The base URL MUST end with /openai/v1/ (it will be normalised automatically).
AZURE_OPENAI_API_KEY=...
AZURE_OPENAI_BASE_URL=https://<YOUR-RESOURCE-NAME>.openai.azure.com/openai/v1/

# Deployment names — these map to models you deployed in Azure OpenAI Studio.
# "model" in API calls = the deployment name.
AZURE_OPENAI_DEPLOYMENT_DEFAULT=gpt-4o-mini
AZURE_OPENAI_DEPLOYMENT_COMPROMISES=gpt-4o
AZURE_OPENAI_DEPLOYMENT_PREF_EXTRACT=gpt-4o-mini

# ── OpenAI fallback (optional) ────────────────────────────
# If AZURE_OPENAI_API_KEY is NOT set, the app falls back to vanilla OpenAI.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=                  # leave blank for api.openai.com
# OPENAI_MODEL_COMPROMISES=gpt-4o
# OPENAI_MODEL_PREF_EXTRACT=gpt-4o-mini

# ── LLM tuning knobs ──────────────────────────────────────
# Timeout per request (ms). Default 20000.
OPENAI_TIMEOUT_MS=20000
# Max automatic retries on transient errors. Default 2.
OPENAI_MAX_RETRIES=2

# ── Upstash Redis (optional – app works without it) ───────
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# Default search cache TTL in seconds. Default 86400 (24h).
CACHE_TTL_SECONDS=86400

# Quiz analysis cache TTL in seconds. Default 21600 (6h).
QUIZ_CACHE_TTL_SECONDS=21600

# ── Prisma ─────────────────────────────────────────────────
# Set to "true" to log every SQL query (noisy, dev only).
PRISMA_LOG_QUERIES=false
